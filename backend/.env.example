# GitHub API Token (Optional, increases rate limits for repository fetching)
GITHUB_TOKEN=your_github_personal_access_token_here

# Gemini / LLM Model Configuration (Google Generative Language API / AI Studio)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MOCK_MODE=false
GEMINI_TIMEOUT_SECONDS=65.0

# Sarvam AI Voice Agent Configuration (Indus / Samvaad)
# Obtain from Sarvam AI dashboard (https://apps.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_APP_ID=Conversatio-6103dad4-f01f
SARVAM_WORKSPACE_ID=your_sarvam_workspace_id_here
SARVAM_ORG_ID=your_sarvam_org_id_here
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_STT_MODEL=saaras:v4
SARVAM_API_BASE=https://apps.sarvam.ai/api/app-runtime
SARVAM_TIMEOUT_SECONDS=15.0
